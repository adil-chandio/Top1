{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonarchStudioViralReadyScorecard",
  "type": "object",
  "required": [
    "project_id",
    "disclaimer",
    "scores",
    "total_score",
    "gate_checks",
    "passed"
  ],
  "properties": {
    "project_id": { "type": "string" },
    "disclaimer": { "type": "string", "minLength": 20 },
    "scores": {
      "type": "object",
      "required": [
        "viewer_promise_clarity",
        "visible_proof_potential",
        "novelty",
        "evidence_strength",
        "emotional_stakes_value",
        "short_long_format_fit",
        "rights_certainty",
        "production_feasibility"
      ],
      "properties": {
        "viewer_promise_clarity": { "type": "number", "minimum": 0, "maximum": 20 },
        "visible_proof_potential": { "type": "number", "minimum": 0, "maximum": 20 },
        "novelty": { "type": "number", "minimum": 0, "maximum": 15 },
        "evidence_strength": { "type": "number", "minimum": 0, "maximum": 15 },
        "emotional_stakes_value": { "type": "number", "minimum": 0, "maximum": 10 },
        "short_long_format_fit": { "type": "number", "minimum": 0, "maximum": 10 },
        "rights_certainty": { "type": "number", "minimum": 0, "maximum": 5 },
        "production_feasibility": { "type": "number", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "gate_checks": {
      "type": "object",
      "required": [
        "score_strong",
        "claim_ledger_complete",
        "title_thumbnail_promise_clear",
        "eight_to_twelve_sec_proof_possible",
        "owner_selection_confirmed"
      ],
      "properties": {
        "score_strong": { "type": "boolean" },
        "claim_ledger_complete": { "type": "boolean" },
        "title_thumbnail_promise_clear": { "type": "boolean" },
        "eight_to_twelve_sec_proof_possible": { "type": "boolean" },
        "owner_selection_confirmed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  }
}
