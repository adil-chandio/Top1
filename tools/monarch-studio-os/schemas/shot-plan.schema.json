{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonarchStudioShotPlan",
  "type": "object",
  "required": ["project_id", "fps", "master_resolution", "shots"],
  "properties": {
    "project_id": { "type": "string" },
    "fps": { "type": "integer", "enum": [24, 30, 60] },
    "master_resolution": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_index",
          "chapter",
          "first_frame",
          "end_frame",
          "camera_id",
          "lens_mm_equiv",
          "subject",
          "camera_motivation",
          "focus_logic",
          "mobile_6in_safe"
        ],
        "properties": {
          "shot_index": { "type": "integer", "minimum": 1 },
          "chapter": { "type": "integer", "minimum": 1 },
          "first_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "camera_id": { "type": "integer" },
          "lens_mm_equiv": { "type": "number" },
          "subject": { "type": "string", "minLength": 3 },
          "camera_motivation": { "type": "string", "minLength": 12 },
          "focus_logic": { "type": "string", "minLength": 8 },
          "mobile_6in_safe": { "type": "boolean" }
        }
      }
    }
  }
}
