{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonarchStudioClaimsLedger",
  "type": "object",
  "required": [
    "project_id",
    "script_version",
    "sources",
    "forbidden_phrases",
    "paragraph_claims"
  ],
  "properties": {
    "project_id": { "type": "string" },
    "script_version": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "citation",
          "doi_or_url",
          "access_date",
          "source_type",
          "license",
          "exact_claims_supported",
          "claims_not_supported"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "citation": { "type": "string" },
          "doi_or_url": { "type": "string" },
          "access_date": { "type": "string" },
          "source_type": { "enum": ["peer-reviewed-paper", "dataset", "archived-benchmark"] },
          "license": { "type": "string" },
          "exact_claims_supported": { "type": "array", "items": { "type": "string" } },
          "claims_not_supported": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "forbidden_phrases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 3 },
          "reason": { "type": "string", "minLength": 5 }
        }
      }
    },
    "paragraph_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "paragraph_index",
          "chapter",
          "category",
          "source_ids",
          "bound_note"
        ],
        "properties": {
          "paragraph_index": { "type": "integer", "minimum": 0 },
          "chapter": { "type": "integer", "minimum": 1 },
          "category": {
            "enum": [
              "directly_observed",
              "measured",
              "published_finding",
              "derived_calculation",
              "modelled_reconstruction",
              "illustrative_animation",
              "hypothesis",
              "unknown_limitation"
            ]
          },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "bound_note": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
