{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonarchStudioRightsManifest",
  "type": "object",
  "required": ["project_id", "spdx_default_code_license", "assets"],
  "properties": {
    "project_id": { "type": "string" },
    "spdx_default_code_license": { "type": "string" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "source",
          "spdx_or_terms",
          "commercial_use_cleared",
          "usage_scope"
        ],
        "properties": {
          "asset_id": { "type": "string" },
          "asset_type": {
            "enum": [
              "paper",
              "data",
              "font",
              "sound",
              "texture",
              "model",
              "code",
              "reference_image",
              "voice"
            ]
          },
          "source": { "type": "string" },
          "spdx_or_terms": { "type": "string" },
          "sha256": { "type": ["string", "null"] },
          "commercial_use_cleared": { "type": "boolean" },
          "usage_scope": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
