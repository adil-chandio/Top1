{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://top1.local/schemas/outlier_scan.schema.json",
  "title": "Top1 YouTube outlier scan artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool", "schema_version", "source", "generated_at", "parameters",
    "stats", "errors", "outliers"
  ],
  "properties": {
    "tool": { "const": "youtube-outlier-scan" },
    "schema_version": { "type": "integer", "enum": [1] },
    "source": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords", "min_views", "max_subs", "min_ratio", "format",
        "lookback_days", "surrounding_uploads", "min_surrounding_uploads",
        "results_per_keyword", "uploads_per_channel"
      ],
      "properties": {
        "keywords": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "min_views": { "type": "integer", "minimum": 1 },
        "max_subs": { "type": "integer", "minimum": 1 },
        "min_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "format": { "enum": ["short", "long", "both"] },
        "lookback_days": { "type": "integer", "minimum": 1 },
        "surrounding_uploads": { "type": "integer", "enum": [10] },
        "min_surrounding_uploads": { "type": "integer", "enum": [5] },
        "results_per_keyword": { "type": "integer", "minimum": 1 },
        "uploads_per_channel": { "type": "integer", "minimum": 1 }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_calls", "quota_units_estimate", "candidates_seen", "qualified", "excluded"],
      "properties": {
        "api_calls": { "type": "integer", "minimum": 0 },
        "quota_units_estimate": { "type": "integer", "minimum": 0 },
        "candidates_seen": { "type": "integer", "minimum": 0 },
        "qualified": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "errors": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } },
    "outliers": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "video_id", "keyword", "title", "channel_id", "channel_title", "published_at",
          "duration_seconds", "format_hint", "view_count", "subscriber_count",
          "median_surrounding_views", "surrounding_sample_size", "outlier_multiple",
          "url", "thumbnail_url", "thumbnail_maxres"
        ],
        "properties": {
          "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "keyword": { "type": "string", "minLength": 1 },
          "title": { "type": ["string", "null"] },
          "channel_id": { "type": ["string", "null"] },
          "channel_title": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
          "format_hint": { "enum": ["short", "long"] },
          "view_count": { "type": "integer", "minimum": 0 },
          "subscriber_count": { "type": "integer", "minimum": 0 },
          "median_surrounding_views": { "type": "number", "exclusiveMinimum": 0 },
          "surrounding_sample_size": { "type": "integer", "minimum": 5, "maximum": 10 },
          "outlier_multiple": { "type": "number", "exclusiveMinimum": 0 },
          "url": { "type": "string", "pattern": "^https://www\\.youtube\\.com/watch\\?v=" },
          "thumbnail_url": { "type": "string", "pattern": "^https://i\\.ytimg\\.com/" },
          "thumbnail_maxres": { "type": "string", "pattern": "^https://i\\.ytimg\\.com/" }
        }
      }
    }
  }
}
