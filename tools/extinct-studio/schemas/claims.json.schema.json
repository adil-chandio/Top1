{
  "title": "Extinct Studio \u2014 claims register",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "directly-observed",
              "measured",
              "published-finding",
              "derived-calculation",
              "modelled-reconstruction",
              "illustrative-animation",
              "hypothesis",
              "unknown-limitation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
