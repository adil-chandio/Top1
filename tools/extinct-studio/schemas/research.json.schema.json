{
  "title": "Extinct Studio \u2014 research record",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "sources",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "type",
          "license",
          "accessedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "paper",
              "data",
              "video",
              "thumbnail",
              "channel",
              "document",
              "image",
              "other"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "accessedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "classification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "directly-observed",
              "measured",
              "published-finding",
              "derived-calculation",
              "hypothesis",
              "unknown-limitation"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
