{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top1.invalid/extinct-studio/claims.schema.json",
  "title": "Extinct Studio claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "type", "supporting_source_ids", "status", "on_screen"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "type": {"enum": ["observed", "measured", "published", "derived", "modelled", "illustrative", "hypothesis", "limitation"]},
          "supporting_source_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["draft", "verified", "rejected"]},
          "on_screen": {"type": "boolean"},
          "limitation": {"type": "string"}
        }
      }
    }
  }
}
