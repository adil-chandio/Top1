{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top1.invalid/extinct-studio/ideas.schema.json",
  "title": "Extinct Studio idea candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ideas"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "promise", "audience_clarity", "visual_proof", "novelty", "evidence_strength", "stakes", "format_fit", "rights", "feasibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "promise": {"type": "string", "minLength": 12},
          "audience_clarity": {"type": "integer", "minimum": 0, "maximum": 5},
          "visual_proof": {"type": "integer", "minimum": 0, "maximum": 5},
          "novelty": {"type": "integer", "minimum": 0, "maximum": 5},
          "evidence_strength": {"type": "integer", "minimum": 0, "maximum": 5},
          "stakes": {"type": "integer", "minimum": 0, "maximum": 5},
          "format_fit": {"type": "integer", "minimum": 0, "maximum": 5},
          "rights": {"type": "integer", "minimum": 0, "maximum": 5},
          "feasibility": {"type": "integer", "minimum": 0, "maximum": 5}
        }
      }
    }
  }
}
