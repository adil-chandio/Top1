{
  "title": "Extinct Studio \u2014 shot plan",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "format",
    "totalSeconds",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "format": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ]
    },
    "totalSeconds": {
      "type": "number",
      "minimum": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "range",
          "screen",
          "evidenceType"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?-\\d+(\\.\\d+)?$"
          },
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "evidenceType": {
            "type": "string",
            "enum": [
              "directly-observed",
              "measured",
              "published-finding",
              "derived-calculation",
              "modelled-reconstruction",
              "illustrative-animation",
              "hypothesis",
              "unknown-limitation"
            ]
          }
        }
      }
    }
  }
}
