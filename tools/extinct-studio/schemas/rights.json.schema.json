{
  "title": "Extinct Studio \u2014 rights manifest",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceType",
          "url",
          "license",
          "commercialAllowed",
          "accessDate"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "paper",
              "data",
              "font",
              "sound",
              "texture",
              "model",
              "code",
              "reference-image",
              "voice"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "commercialAllowed": {
            "type": "boolean"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "accessDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
