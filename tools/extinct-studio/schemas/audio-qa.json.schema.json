{
  "title": "Extinct Studio \u2014 audio QA report",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "lufs",
    "truePeakDb",
    "clipping",
    "aacReencodeCheck",
    "monoCompatible",
    "phoneSpeakerReview",
    "checkedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "lufs": {
      "type": "number"
    },
    "truePeakDb": {
      "type": "number"
    },
    "clipping": {
      "type": "string",
      "enum": [
        "clean",
        "present"
      ]
    },
    "aacReencodeCheck": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending"
      ]
    },
    "monoCompatible": {
      "type": "boolean"
    },
    "phoneSpeakerReview": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending"
      ]
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
