{
  "title": "Extinct Studio \u2014 project record",
  "type": "object",
  "required": [
    "projectId",
    "title",
    "targetChannel",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "targetChannel": {
      "type": "string",
      "minLength": 1
    },
    "pilotId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
