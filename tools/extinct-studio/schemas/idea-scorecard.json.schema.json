{
  "title": "Extinct Studio \u2014 idea scorecard",
  "type": "object",
  "required": [
    "createdAt",
    "scores",
    "total",
    "gates",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "pilotId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "scores": {
      "type": "object",
      "required": [
        "viewerPromiseClarity",
        "visibleProofPotential",
        "novelty",
        "evidenceStrength",
        "emotionalStakesValue",
        "shortLongFormatFit",
        "rightsCertainty",
        "productionFeasibility"
      ],
      "additionalProperties": false,
      "properties": {
        "viewerPromiseClarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "visibleProofPotential": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "evidenceStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "emotionalStakesValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "shortLongFormatFit": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rightsCertainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "productionFeasibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "gates": {
      "type": "object",
      "required": [
        "claimLedgerComplete",
        "titlePromiseClear",
        "proofPossible",
        "ownerSelection"
      ],
      "additionalProperties": false,
      "properties": {
        "claimLedgerComplete": {
          "type": "boolean"
        },
        "titlePromiseClear": {
          "type": "boolean"
        },
        "proofPossible": {
          "type": "boolean"
        },
        "ownerSelection": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "production-candidate",
        "not-yet",
        "rejected"
      ]
    },
    "rejectReason": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
