{
  "title": "Extinct Studio \u2014 proof receipt",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "proofType",
    "windowSeconds",
    "checkedBy",
    "checkedAt",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "proofType": {
      "type": "string",
      "enum": [
        "moving-clip",
        "still-sequence",
        "render",
        "physical"
      ]
    },
    "windowSeconds": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkedBy": {
      "type": "string",
      "minLength": 1
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
