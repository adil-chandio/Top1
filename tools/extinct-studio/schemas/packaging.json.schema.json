{
  "title": "Extinct Studio \u2014 packaging record",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "title",
    "thumbnailConcepts",
    "thumbnailReadinessChecks",
    "tags",
    "srtId",
    "coverChecks"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "thumbnailConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "thumbnailReadinessChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "size",
          "readability"
        ],
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "enum": [
              "480x360",
              "320x180",
              "120x68",
              "other"
            ]
          },
          "readability": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "srtId": {
      "type": "string",
      "minLength": 1
    },
    "coverChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "size",
          "readability"
        ],
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "enum": [
              "480x360",
              "320x180",
              "120x68",
              "other"
            ]
          },
          "readability": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "launchSheet": {
      "type": "string",
      "minLength": 1
    },
    "ownerAttestation": {
      "type": "object",
      "required": [
        "ownerId",
        "attestedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "attestedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    }
  }
}
