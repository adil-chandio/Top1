{
  "title": "Extinct Studio \u2014 render manifest",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "renderId",
    "inputHeadSha",
    "sceneVersion",
    "assetHashes",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "renderId": {
      "type": "string",
      "minLength": 1
    },
    "inputHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sceneVersion": {
      "type": "string",
      "minLength": 1
    },
    "assetHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "rendered",
        "failed"
      ]
    },
    "renderStartedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "renderFinishedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
