{
  "title": "Extinct Studio \u2014 story record",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "premise",
    "claimCheck",
    "narration",
    "screenDescription",
    "plannedSeconds",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "premise": {
      "type": "string",
      "minLength": 1
    },
    "claimCheck": {
      "type": "object",
      "required": [
        "claimsSupported",
        "claimsNotSupported"
      ],
      "additionalProperties": false,
      "properties": {
        "claimsSupported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "claimsNotSupported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "narration": {
      "type": "string",
      "minLength": 1
    },
    "screenDescription": {
      "type": "string",
      "minLength": 1
    },
    "plannedSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 3600
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "seconds",
          "caption"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
