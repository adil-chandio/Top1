{
  "title": "Extinct Studio \u2014 release status record",
  "type": "object",
  "required": [
    "projectId",
    "createdAt",
    "state",
    "publishedBy",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "state": {
      "type": "string",
      "enum": [
        "idea",
        "researched",
        "shortlisted",
        "owner-selected",
        "claim-checked",
        "scripted",
        "proof-pending",
        "proof-passed",
        "voice-locked",
        "picture-locked",
        "mix-locked",
        "qa-passed",
        "owner-accepted",
        "private-uploaded",
        "published"
      ]
    },
    "publishedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
